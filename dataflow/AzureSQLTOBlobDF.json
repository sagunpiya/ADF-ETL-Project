{
	"name": "AzureSQLTOBlobDF",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL_OrdersTech",
						"type": "DatasetReference"
					},
					"name": "DFOrdersTransformation"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "OrdersTech",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "QuantityMoreThanTwo"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as integer,",
				"          CustomerName as string,",
				"          ProductName as string,",
				"          Quantity as integer,",
				"          Price as decimal(10,2),",
				"          LastModifiedDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DFOrdersTransformation",
				"DFOrdersTransformation filter(Quantity>2) ~> QuantityMoreThanTwo",
				"QuantityMoreThanTwo sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          customer_id as string,",
				"          customer_name as string,",
				"          city as string,",
				"          state as string,",
				"          signup_date as string",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}